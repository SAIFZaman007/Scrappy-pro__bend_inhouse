# ---- Runtime ---------------------------------------------------------------
ENV=local
DEBUG=false
LOG_LEVEL=INFO
APP_PORT=8080

# ---- Security --------------------------------------------------------------
# Generate with:  openssl rand -hex 32
SECRET_KEY="your_super_secret_key_here"
# Comma separated. Use your real domain in production, no trailing slash.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Bootstrap account, created on first boot. Change the password immediately.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change_this_password

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/scrappy_db

# ---- Queue -----------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_URL=redis://redis:6379/0

# ---- Crawl policy ----------------------------------------------------------
# Leave RESPECT_ROBOTS_TXT on unless you have written permission from the site.
RESPECT_ROBOTS_TXT=true
DEFAULT_REQUESTS_PER_SECOND=1.0
DEFAULT_CONCURRENCY=4
REQUEST_TIMEOUT_SECONDS=25
MAX_RETRIES=3
MAX_PAGES_PER_SUBCATEGORY=200
USER_AGENT=ScrappyProBot/1.0 (+https://yourdomain.com/bot; contact=you@yourdomain.com)

# ---- Jobs ------------------------------------------------------------------
MAX_ACTIVE_JOBS_PER_USER=3
EXPORT_DIR=/data/exports
EXPORT_RETENTION_HOURS=72
# WEB_CONCURRENCY=2
